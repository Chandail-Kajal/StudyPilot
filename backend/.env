# Database Configuration
# Supported: mysql | sqlite
DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=studypilot_db

# Frontend Application URL for Password Reset Links
FRONTEND_URL=http://localhost:3000

# Email Delivery Configuration (Optional - set credentials for live email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@studypilot.ai

# AI API Keys (Google Gemini or OpenAI)
# Add your Gemini key here or configure it in the web dashboard
GEMINI_API_KEY=
OPENAI_API_KEY=

